/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f9ff;
}
.scrollarea {
  flex: 1;
  min-height: 0;
}

.page {
  min-height: 100%;
  box-sizing: border-box;
  background: #ffffff;
}

.cover-image {
  display: block;
  width: 100%;
}

.content {
  padding: 42rpx 36rpx 60rpx;
}

.title {
  display: block;
  color: #123f82;
  font-size: 38rpx;
  font-weight: 700;
}

.paragraph {
  display: block;
  margin-top: 26rpx;
  color: #4c6380;
  font-size: 29rpx;
  line-height: 1.8;
}
